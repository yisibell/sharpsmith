{
  "name": "sharpsmith",
  "version": "1.1.5",
  "description": "A spritesmith engine powered by sharp.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/yisibell/sharpsmith",
  "bugs": {
    "url": "https://github.com/yisibell/sharpsmith/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test",
    "playground": "pnpm build && node playground/index.mjs",
    "playground:all": "pnpm build && node playground/index.mjs --all",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release:nobuild": "changelogen --release && npm publish --access=public && git push --follow-tags",
    "release": "npm run build && changelogen --release && npm publish --access=public && git push --follow-tags"
  },
  "keywords": [
    "spritesmith",
    "spritesheet",
    "sharp",
    "image"
  ],
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "changelogen": "^0.6.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "publint": "^0.3.0",
    "spritesmith": "^3.5.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  }
}
